{
  "name": "dsh-shanhai-pet",
  "version": "1.2.0",
  "description": "任务状态驱动的 DSH 桌宠：跟着会话相位换姿势、用台词播报任务进度，不读对话内容。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale",
    "assets",
    "docs",
    "cordis.patch.yml",
    "STORE_REVIEW.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "shanhai",
    "pet",
    "overlay",
    "todo",
    "narration"
  ],
  "author": {
    "name": "山海紫穹",
    "url": "https://github.com/cn-zhangpeng"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cn-zhangpeng/dsh-shanhai-pet.git"
  },
  "license": "MIT"
}
