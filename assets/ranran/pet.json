{
  "petManifestVersion": 2,
  "id": "ranran",
  "displayName": "冉冉",
  "license": "internal",
  "renderer": "frames2d",
  "frames2d": {
    "width": 344,
    "height": 520,
    "animDir": "anim/",
    "tracks": {
      "idle": { "frames": ["breathopen", "breathopen_closed", "breathopen"], "durations": [3600, 200, 900], "loop": true },
      "listening": { "frames": ["earperk"], "durations": [900], "loop": true },
      "thinking": { "frames": ["divine"], "durations": [700], "loop": true },
      "tool": { "frames": ["ridewind"], "durations": [700], "loop": true },
      "tool:ink": { "frames": ["grindink"], "durations": [700], "loop": true },
      "tool:wind": { "frames": ["ridewind"], "durations": [700], "loop": true },
      "tool:sniff": { "frames": ["sniff"], "durations": [700], "loop": true },
      "tool:gaze": { "frames": ["gaze"], "durations": [900], "loop": true },
      "tool:chess": { "frames": ["chess"], "durations": [900], "loop": true },
      "tool:split": { "frames": ["ridewind"], "durations": [700], "loop": true },
      "review": { "frames": ["unroll"], "durations": [1000], "loop": true },
      "done": { "frames": ["lantern"], "durations": [1400], "loop": false, "fallback": "idle" },
      "failed": { "frames": ["tailhug"], "durations": [1200], "loop": true },
      "waiting": { "frames": ["earperk"], "durations": [900], "loop": true },
      "poke1": { "frames": ["breathopen_closed"], "durations": [1200], "loop": true },
      "poke2": { "frames": ["earperk"], "durations": [1200], "loop": true },
      "poke3": { "frames": ["tailhug"], "durations": [1200], "loop": true },
      "poke4": { "frames": ["gaze"], "durations": [1200], "loop": true }
    },
    "phases": {
      "idle": "idle",
      "listening": "listening",
      "thinking": "thinking",
      "tool": "tool",
      "review": "review",
      "done": "done",
      "failed": "failed",
      "waiting": "waiting"
    }
  }
}
